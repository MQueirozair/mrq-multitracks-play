{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MRQ - Multitracks Play",
  "version": "0.1.18",
  "identifier": "com.mrq.multitracksplay",
  "build": {
    "beforeDevCommand": "node scripts/build-rack-worklets.cjs",
    "beforeBuildCommand": "npm run build:renderer",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MRQ - Multitracks Play",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 660,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0b0b0d",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "resources": {
      "../electron/remote-ui/*": "remote-ui/"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
